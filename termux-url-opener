#!/data/data/com.termux/files/usr/bin/bash
# Appelé par Android quand on partage un lien vers Termux (installé dans ~/bin/).
# Chaque partage ouvre une NOUVELLE fenêtre Termux : c'est normal, les liens
# partagés avant restent dans la file d'attente (~/.yt2release_file).
RAW="https://raw.githubusercontent.com/MaxMcNeil/Video-transcriber/main"
FILE="$HOME/.yt2release_file"
termux-wake-lock 2>/dev/null || true

# mises à jour automatiques (script de lancement + ce script pour la prochaine fois)
curl -fsSL -o ~/yt2release.sh.new "$RAW/yt2release.sh" && mv ~/yt2release.sh.new ~/yt2release.sh || true
curl -fsSL -o ~/bin/termux-url-opener.new "$RAW/termux-url-opener" \
  && chmod +x ~/bin/termux-url-opener.new && mv ~/bin/termux-url-opener.new ~/bin/termux-url-opener || true

lien="$1"
touch "$FILE"
grep -qxF -- "$lien" "$FILE" || echo "$lien" >> "$FILE"   # pas de doublon

clear 2>/dev/null || true
nb=$(grep -c . "$FILE")
echo "📋 Vidéos en attente : $nb"
echo "   (les vidéos partagées avant sont bien gardées, même dans une nouvelle fenêtre)"
echo
n=0
while IFS= read -r l; do
  [ -n "$l" ] || continue
  n=$((n + 1)); echo "  $n. $l"
done < "$FILE"
echo
echo "  Entrée       = LANCER ces $nb vidéo(s) ensemble (prompteur dans la langue des vidéos)"
echo "  ar + Entrée  = LANCER avec le prompteur en ARABE   (fr / it / en : idem)"
echo "  a  + Entrée  = attendre : partage la vidéo suivante"
echo "  x  + Entrée  = vider la liste et ne rien lancer"
echo
read -r -t 20 choix || choix=""
choix="$(printf '%s' "$choix" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
langue="auto"
case "$choix" in
  ar|fr|it|en) langue="$choix"; choix="" ;;
esac
case "$choix" in
  a|A)
    echo "✅ Gardé. Partage la vidéo suivante vers Termux (tu peux fermer cette fenêtre)."
    sleep 3; exit 0 ;;
  x|X)
    rm -f "$FILE"
    echo "🗑️  Liste vidée, rien n'a été lancé."
    sleep 3; exit 0 ;;
esac
mapfile -t liens < <(sed '/^$/d' "$FILE")
rm -f "$FILE"
[ "$langue" != auto ] && echo "Prompteur en : $langue"
PROMPTEUR="$langue" bash ~/yt2release.sh "${liens[@]}"
echo
echo "Tu peux fermer Termux (le traitement continue sur GitHub)."
read -r -t 30 _ || true
