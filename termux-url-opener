#!/data/data/com.termux/files/usr/bin/bash
# Appelé par Android quand on partage un lien vers Termux (installé dans ~/bin/).
# Chaque partage ouvre une NOUVELLE fenêtre Termux : c'est normal, les liens
# partagés avant restent dans la file d'attente (~/.yt2release_file).
RAW="https://raw.githubusercontent.com/MaxMcNeil/Video-transcriber/main"
FILE="$HOME/.yt2release_file"
termux-wake-lock 2>/dev/null || true

# mises à jour automatiques (script de lancement + ce script pour la prochaine fois)
curl -fsSL -o ~/yt2release.sh.new "$RAW/yt2release.sh" && mv ~/yt2release.sh.new ~/yt2release.sh || true
if [ -z "${YT2R_MAJ:-}" ] && curl -fsSL -o ~/bin/termux-url-opener.new "$RAW/termux-url-opener"; then
  if ! cmp -s ~/bin/termux-url-opener.new ~/bin/termux-url-opener; then
    chmod +x ~/bin/termux-url-opener.new && mv ~/bin/termux-url-opener.new ~/bin/termux-url-opener
    YT2R_MAJ=1 exec bash ~/bin/termux-url-opener "$@"     # relance tout de suite la nouvelle version
  fi
  rm -f ~/bin/termux-url-opener.new
fi

# TikTok, X, Instagram… partagent parfois une phrase avec le lien (« Regarde cette vidéo de @… https://vm.tiktok.com/… ») :
# on garde seulement le(s) lien(s) qu'elle contient (ponctuation finale retirée), jamais le texte autour
mapfile -t trouves < <(printf '%s\n' "$*" | grep -oE 'https?://[^[:space:]<>"]+' | sed -E 's/[).,;:!?»”"]+$//')
if [ ${#trouves[@]} -eq 0 ]; then
  clear 2>/dev/null || true
  echo "❓ Aucun lien dans ce qui a été partagé :"
  echo "   $*"
  echo "   (rien n'a été ajouté à la liste)"
  read -r -t 15 _ || true
  exit 0
fi
# ---------------------------------------------------------------------------------------------------------------------
# 1er lien partagé (liste vide) : on demande d'abord QUOI en faire — transcription (comme avant) ou vidéo à commenter
# ---------------------------------------------------------------------------------------------------------------------
commenter() {   # $1 = lien de la vidéo à commenter
  local url="$1" rem nom titre langue duree avant id i
  local OSINT="MaxMcNeil/OSINT-teleprompter-" JOINTS="montage-joints" W="$HOME/.commentaire"
  clear 2>/dev/null || true
  echo "🎙  VIDÉO À COMMENTER"
  echo "   $url"
  echo
  # outils (une seule fois)
  local manque=()
  command -v ffmpeg >/dev/null || manque+=(ffmpeg)
  command -v rclone >/dev/null || manque+=(rclone)
  command -v gh >/dev/null || manque+=(gh)
  command -v node >/dev/null || manque+=(nodejs)
  [ ${#manque[@]} -eq 0 ] || pkg install -y "${manque[@]}"
  command -v yt-dlp >/dev/null || pip install -q -U "yt-dlp[default]"
  rem="$(rclone listremotes 2>/dev/null | grep -m1 -x 'gdrive:' || rclone listremotes 2>/dev/null | head -1)"
  rem="${rem%:}"
  if [ -z "$rem" ]; then
    echo "❌ Google Drive n'est pas relié à Termux (rclone). Tape « rclone config » (même compte Google que tes"
    echo "   workflows), puis partage la vidéo à nouveau."
    read -r -t 60 _ || true; return 1
  fi
  gh auth status >/dev/null 2>&1 || gh auth login
  # langue de TON script (la vidéo, elle, peut être dans n'importe quelle langue)
  langue=""
  while [ -z "$langue" ]; do
    echo "🌍 Langue de TON script ?  fr (Entrée) · ar · it · en"
    read -r -t 60 rep || rep=""
    rep="$(printf '%s' "$rep" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
    case "$rep" in ""|fr) langue=fr ;; ar|it|en) langue="$rep" ;; *) echo "❓ Tape fr, ar, it ou en." ;; esac
  done
  echo
  echo "⏱  Durée de ton commentaire en minutes ? (Entrée = 15)"
  read -r -t 60 duree || duree=""
  duree="$(printf '%s' "$duree" | tr -cd '0-9')"; [ -n "$duree" ] || duree=15
  # téléchargement depuis le téléphone (720p max : assez pour la moitié de l'écran, envoi rapide)
  rm -rf "$W" && mkdir -p "$W"
  echo
  echo "📥 Téléchargement de la vidéo…"
  if ! yt-dlp --js-runtimes node --no-playlist --restrict-filenames --retries 10 \
       -f "bv*[height<=720]+ba/b[height<=720]/bv*+ba/b" --merge-output-format mp4 \
       -o "$W/%(title).60B-%(id)s.%(ext)s" "$url"; then
    echo "❌ Téléchargement impossible (lien privé, supprimé, ou non pris en charge)."
    read -r -t 60 _ || true; return 1
  fi
  nom="$(basename "$(find "$W" -type f -name '*.mp4' | head -n1)")"
  [ -n "$nom" ] || { echo "❌ Aucune vidéo téléchargée."; read -r -t 60 _ || true; return 1; }
  case "$(printf '%s' "$nom" | tr '[:upper:]' '[:lower:]')" in moi*) mv "$W/$nom" "$W/video-$nom"; nom="video-$nom" ;; esac
  echo "☁️  Dépôt dans ton Drive « $JOINTS » : $nom ($(du -h "$W/$nom" | cut -f1))"
  for i in 1 2 3; do
    rclone copyto "$W/$nom" "$rem:$JOINTS/$nom" --retries 3 -q && break
    echo "⚠️  Envoi interrompu (essai $i/3), nouvel essai…"; sleep 10
  done
  rclone lsf "$rem:$JOINTS/$nom" >/dev/null 2>&1 && [ -n "$(rclone lsf "$rem:$JOINTS/$nom" 2>/dev/null)" ] \
    || { echo "❌ La vidéo n'a pas pu être déposée dans Drive (connexion ?). Partage-la à nouveau."; read -r -t 60 _ || true; return 1; }
  rm -rf "$W"
  # le prompteur en mode commentaire, sur CETTE vidéo (jamais une autre du dossier)
  echo "🚀 Lancement du prompteur (mode commentaire, script en $langue, ≈ $duree min)…"
  avant="$(gh run list -R "$OSINT" -w generate.yml -L 1 --json databaseId -q '.[0].databaseId' 2>/dev/null)"
  for i in 1 2 3; do
    if gh workflow run generate.yml -R "$OSINT" -f mode="commentaire d'une vidéo" -f video_commentee="$nom" \
         -f langue="$langue" -f duree="$duree"; then
      id=""
      for _ in $(seq 1 12); do
        sleep 5
        id="$(gh run list -R "$OSINT" -w generate.yml -L 1 --json databaseId -q '.[0].databaseId' 2>/dev/null)"
        [ -n "$id" ] && [ "$id" != "$avant" ] && break
      done
      if [ -n "$id" ] && [ "$id" != "$avant" ]; then
        echo
        echo "✅ C'est lancé : https://github.com/$OSINT/actions/runs/$id"
        echo "   Dans ≈ 5 à 10 min : ton script dans OSINT-teleprompter-, dossier prompter/ (…_commentaire-…)."
        echo "   La vidéo reste dans « $JOINTS » pour le fond vert et le Montage (mode commentaire d'une vidéo)."
        read -r -t 60 _ || true; return 0
      fi
    fi
    echo "⚠️  Lancement non confirmé (essai $i/3), nouvel essai dans 15 s…"; sleep 15
  done
  echo "❌ GitHub n'a pas démarré le prompteur. La vidéo est bien dans « $JOINTS » : lance « Générer le script »"
  echo "   à la main (mode = commentaire d'une vidéo, video_commentee = $nom)."
  read -r -t 120 _ || true; return 1
}

if [ ! -s "$FILE" ] && [ ${#trouves[@]} -eq 1 ]; then
  clear 2>/dev/null || true
  echo "🔗 ${trouves[0]}"
  echo
  echo "  Entrée       = 📝 TRANSCRIPTION (comme d'habitude)"
  echo "  c  + Entrée  = 🎙  VIDÉO À COMMENTER (prompteur + montage « commentaire d'une vidéo »)"
  echo
  read -r -t 30 quoi || quoi=""
  case "$(printf '%s' "$quoi" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')" in
    c|commentaire|commenter) commenter "${trouves[0]}"; exit $? ;;
    a|x) PRECHOIX="$quoi" ;;      # « a » / « x » tapé tout de suite : transcription, et ce choix est gardé
  esac
fi

touch "$FILE"
for lien in "${trouves[@]}"; do
  grep -qxF -- "$lien" "$FILE" || echo "$lien" >> "$FILE"   # pas de doublon
done

clear 2>/dev/null || true
nb=$(grep -c . "$FILE")
echo "📋 Vidéos en attente : $nb"
echo "   (les vidéos partagées avant sont bien gardées, même dans une nouvelle fenêtre)"
echo
n=0
while IFS= read -r l; do
  [ -n "$l" ] || continue
  n=$((n + 1)); echo "  $n. $l"
done < "$FILE"
echo
echo "  Entrée       = J'AI FINI : lancer ces $nb vidéo(s) ensemble"
echo "  a  + Entrée  = attendre : partage la vidéo suivante"
echo "  x  + Entrée  = vider la liste et ne rien lancer"
echo
if [ -n "${PRECHOIX:-}" ]; then choix="$PRECHOIX"; else read -r -t 20 choix || choix=""; fi
choix="$(printf '%s' "$choix" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
langue="auto"
case "$choix" in
  ar|fr|it|en) langue="$choix"; choix="" ;;
esac
case "$choix" in
  a|A)
    echo "✅ Gardé. Partage la vidéo suivante vers Termux (tu peux fermer cette fenêtre)."
    sleep 3; exit 0 ;;
  x|X)
    rm -f "$FILE"
    echo "🗑️  Liste vidée, rien n'a été lancé."
    sleep 3; exit 0 ;;
esac
# Langue du texte prompteur : toujours demandée au lancement (sauf si déjà tapée)
while [ "$langue" = auto ]; do
  echo
  echo "🌍 Langue du texte prompteur ?"
  echo "   ar = arabe   fr = français   it = italien   en = anglais"
  echo "   (Entrée seule = langue majoritaire des vidéos)"
  read -r -t 60 rep || rep=""
  rep="$(printf '%s' "$rep" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
  case "$rep" in
    ar|fr|it|en) langue="$rep" ;;
    "") break ;;
    *) echo "❓ Tape ar, fr, it ou en." ;;
  esac
done
mapfile -t liens < <(sed '/^$/d' "$FILE")
rm -f "$FILE"
echo "Prompteur en : $langue"
PROMPTEUR="$langue" bash ~/yt2release.sh "${liens[@]}"
echo
echo "Tu peux fermer Termux (le traitement continue sur GitHub)."
read -r -t 30 _ || true
